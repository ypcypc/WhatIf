# ── 环境变量 ──
.env
.env.*
!.env.example

# ── Python ──
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.ruff_cache/
.mypy_cache/
.pytest_cache/
.venv*/

# ── Node / 前端 ──
node_modules/
frontend/dist/
frontend/dist-electron/
frontend/release/
frontend/release-patched/

# ── 后端构建产物 ──
backend/build/
backend/dist/

# ── 编辑器 ──
.vscode/
.idea/
*.sw?
.DS_Store
Thumbs.db
*.local

# ── 运行时数据 ──
output/*/
output/*.wpkg
!output/.gitkeep
logs/dev/
logs/sessions/*.jsonl
!logs/**/.gitkeep
saves/*/
